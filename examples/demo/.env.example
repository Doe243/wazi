# Les réglages de la démonstration.
#
# Copiez ce fichier sous le nom « .env » (sans « .example »), puis modifiez-le.
# Le fichier .env ne se partage pas et ne s'envoie pas dans Git : sur un vrai
# site, il contient des secrets.
#
# Chaque réglage peut aussi être donné par une variable d'environnement du
# serveur, qui passe alors avant ce fichier.

# true : le navigateur affiche le message des erreurs (fichier, ligne, solution).
# À ne JAMAIS activer sur un site en ligne.
APP_DEBUG=true

# Les noms sous lesquels le site répond, séparés par des virgules.
# Vide : tout nom est accepté (pratique sur votre ordinateur, à remplir en ligne).
APP_HOSTS=

# Les adresses de VOS proxies (répartiteur de charge, Cloudflare...), séparées
# par des virgules. Vide : les en-têtes X-Forwarded-* ne sont jamais crus.
APP_TRUSTED_PROXIES=

# La base de données. Sans ce réglage : un fichier SQLite, var/demo.sqlite.
#DATABASE_URL=sqlite:var/demo.sqlite

# Le secret partagé avec le programme qui appelle /webhook.
# Vide : la route /webhook répond 404.
DEMO_WEBHOOK_SECRET=secret-de-demo
