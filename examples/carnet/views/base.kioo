<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><k:block name="titre">Mon carnet</k:block> — Carnet</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&display=swap">
    <style>
        body { margin: 0; background: #F3F8F8; color: #0D2B30; font-family: 'Sora', system-ui, sans-serif; line-height: 1.55; }
        header, main, footer { max-width: 42rem; margin: 0 auto; padding: 1.5rem 1.25rem; }
        header { display: flex; align-items: center; gap: .75rem; }
        header a { color: inherit; text-decoration: none; font-weight: 700; font-size: 1.25rem; letter-spacing: -.02em; }
        h1 { font-size: 1.75rem; letter-spacing: -.02em; margin: 0 0 1rem; }
        a { color: #0B6E70; }
        ul.notes { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; }
        ul.notes li { background: #fff; border: 1px solid #C5DAD9; border-radius: 1rem; padding: .9rem 1.1rem; }
        ul.notes li.importante { border-color: #12A3A0; }
        .pastille { font-size: .8rem; font-weight: 600; color: #0B6E70; background: #D6EEEC; border-radius: 999px; padding: .15rem .6rem; }
        footer { color: #3F5B5F; font-size: .9rem; border-top: 1px solid #C5DAD9; }
    </style>
</head>
<body>
<header>
    <svg width="38" height="28" viewBox="0 0 76 56" fill="none" aria-hidden="true">
        <path d="M6 8 L24 48 L40 14" stroke="#0D2B30" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M36 14 L52 48 L70 8" stroke="#12A3A0" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" opacity="0.85"/>
    </svg>
    <a href="/">Carnet</a>
</header>
<main>
<k:block name="content"></k:block>
</main>
<k:include file="partiels/pied" annee="{annee}">
</body>
</html>
