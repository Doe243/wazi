{
    "name": "wazi/framework",
    "description": "Wazi, le framework PHP où tout est clair : puissant, simple, et pensé pour comprendre ce qu'on construit.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/wazi-php/wazi",
    "support": {
        "issues": "https://github.com/wazi-php/wazi/issues",
        "source": "https://github.com/wazi-php/wazi",
        "docs": "https://github.com/wazi-php/wazi/blob/main/docs/README.md",
        "security": "https://github.com/wazi-php/wazi/security/policy"
    },
    "keywords": [
        "framework",
        "psr-7",
        "psr-15",
        "pedagogique",
        "wazi"
    ],
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "suggest": {
        "ext-pdo_sqlite": "Pour une base de données SQLite avec Wazi\\Database",
        "ext-pdo_mysql": "Pour une base de données MySQL ou MariaDB avec Wazi\\Database",
        "ext-pdo_pgsql": "Pour une base de données PostgreSQL avec Wazi\\Database"
    },
    "provide": {
        "psr/container-implementation": "2.0",
        "psr/http-factory-implementation": "1.0",
        "psr/http-message-implementation": "2.0"
    },
    "autoload": {
        "psr-4": {
            "Wazi\\": "src/"
        }
    },
    "bin": [
        "bin/wazi"
    ],
    "autoload-dev": {
        "psr-4": {
            "Wazi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "deptrac": "deptrac analyse --no-progress",
        "check": [
            "@composer audit",
            "@cs",
            "@stan",
            "@deptrac",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "check": "Lance tous les contrôles qualité, comme l'intégration continue."
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
